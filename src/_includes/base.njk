<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} – {{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="logo">
        <img src="/assets/images/logo.png" alt="{{ site.title }}" height="48">
      </a>
      <nav class="main-nav">
        <a href="/#about-me">About Me</a>
        <a href="/#services">Services</a>
        <a href="https://inflexion.nthlayer.co.uk">Inflexion</a>
        <a href="/whitepaper/">Whitepaper</a>


      </nav>
      <button class="mobile-nav-toggle" aria-label="Toggle navigation">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>

  <script>
  (function(){
    var toggle = document.querySelector('.mobile-nav-toggle');
    var nav = document.querySelector('.main-nav');
    if(toggle && nav){
      toggle.addEventListener('click', function(){
        nav.classList.toggle('open');
      });
    }
  })();
  </script>


  <main>
    {{ content | safe }}
  </main>


  <footer class="site-footer">
    <div class="container">
