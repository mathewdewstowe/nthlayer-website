	.toggle > .toggle-title a {
	color: #001D21 !important;
	font-size: 15px !important;
	line-height: 25px !important;
	padding: 22px 50px 23px 15px !important;
	background-color: #fff !important;
	border-radius: 14px !important;
	font-weight: 600 !important;
}
	body .toggle > div {
	border-radius: 0 0 20px 20px;
		color:#363636;
}
	.toggle.default.open .toggle-title a {
	padding-bottom: 0 !important;
	border-radius: 20px 20px 0 0 !important;
}
	.toggle-title a i {
		display:none !important;
	}
	.toggle-title a::after {
	content: '';
	width: 30px;
	height: 30px;
	background: url("https://nthlayer.co.uk/wp-content/uploads/2025/11/plus.png");
	display: inline-block;
	position: absolute;
	right: 15px;
	top: calc(50% - 15px);
	background-size: cover;
		transition: ease all .3s;
}
	.toggle.default.open .toggle-title a::after {
	transform: rotate(45deg);
	transition: ease all .3s;
}
	body.home .nectar-global-section.before-footer {
	margin-top: 0;
}
	
