.chat-section {
	margin-top: -230px;
}
.vc_custom_heading.vc_do_custom_heading.z-index-top {
	z-index: 99999;
	position: relative;
}
body.home .nectar-global-section.before-footer {
	margin-top: -160px;
}
.vc_col-sm-12.chart-section-col, .vc_col-sm-12.chart-section-col > div {
    overflow: visible !important;
}
.chat-section, .chat-section .row_col_wrap_12_inner.col.span_12.left {
    overflow: visible !important;
}
.wpcf7-form-control-wrap {
	width: calc(50% - 15px);
	display: inline-block;
	float: left;
	margin: 7.5px;
}
.wpcf7-form-control {
	border: 1px solid #ccc !important;
}
.wpcf7-form-control-wrap[data-name="telephone"],
.wpcf7-form-control-wrap[data-name="your-message"] {
	width: calc(100% - 15px);
}
.wpcf7-form-control.wpcf7-textarea {
	height: 100px;
}
.wpcf7-form-control.wpcf7-submit.has-spinner {
	padding: 15px 25px !important;
	background: rgb(0, 29, 33);
	font-size: 16px;
	font-family: Inter;
	font-weight: 500 !important;
	border-radius: 10px !important;
	border: none !important;
	margin-top: 7.5px;
	height: auto;
}
.problem-item {
	background: #001D21;
	border-radius: 10px;
	/* font-size: 18px; */
	font-family: Inter;
	line-height: 26px;
	color: rgba(255, 255, 255, 0.85);
	padding-left: 29px;
	padding-right: 60px;
	padding-top: 29px;
	padding-bottom: 35px;
	margin-bottom: 18px !important;
}
.wpb_text_column.wpb_content_element.solution-item {
	background: #fff;
	color: #212121;
	padding-top: 22px;
	padding-left: 28px;
	padding-bottom: 21px;
	padding-right: 40px;
	margin-bottom: 15px;
	border-radius: 10px;
}
.solution-top-text {
	color: #212121;
}
.section-small-text {
    text-align:center;
}
@media only screen and (max-width: 700px) {
 .section-small-text {
    text-align:left;
}
    .wpcf7-form-control-wrap {
	width: calc(100% - 15px);
}
.wpcf7-form-control {
	border: 1px solid #ccc !important;
	height: 40px;
}
body.material .trusted-title {
	font-size: 14px !important;
	padding: 9px 11px;
}
.icon-text-section .iwt-icon {
	position: relative;
	display: block;
	margin:0 0 15px 0;
}
.icon-text-section .iwt-text {
	padding-left: 0;
	font-size: 16px;
	line-height: 24px;
	text-align: left;
}
.problem-item,
.wpb_text_column.wpb_content_element.solution-item {
	font-size: 16px !important;
	padding-left: 15px;
	padding-right: 15px;
	padding-top: 15px;
	padding-bottom: 20px;
	margin-bottom: 18px !important;
}
.left-text-heading {
	text-align: left !important;
}
}
